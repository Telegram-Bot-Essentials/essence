{
    "name": "elyar/telegram-bot-essentials",
    "description": "This is the how i like to develop my bots and handle different incoming requests",
    "version": "0.7.7",
    "type": "library",
    "require": {
        "php": "^8.2",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "laravel/framework": "^12",
        "ramsey/uuid": "^4.7",
        "stancl/tenancy": "^3.9"
    },
    "license": "GPL-3.0",
    "autoload": {
        "psr-4": {
            "Elyar\\TelegramBotEssentials\\": "src/",
            "Elyar\\TelegramBotEssentials\\Tests\\": "tests"
        },
        "files": [
            "src/helpers.php"
        ],
        "classmap": [
            "database/factories"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyar.ranjbar0@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Elyar\\TelegramBotEssentials\\TelegramBotServiceProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "orchestra/testbench": "^10.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/pest"
        ]
    }
}