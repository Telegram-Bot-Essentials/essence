{
    "name": "elyar/telegram-bot-essentials",
    "description": "This is the how i like to develop my bots and handle different incoming requests",
    "version": "0.6.8",
    "type": "library",
    "require": {
        "php": "^8.2",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "laravel/framework": "^12",
        "spatie/laravel-multitenancy": "^4.0",
        "ramsey/uuid": "^4.7"
    },
    "license": "GPL-3.0",
    "autoload": {
        "psr-4": {
            "Elyar\\TelegramBotEssentials\\": "src/",
            "Elyar\\TelegramBotEssentials\\Tests\\": "tests"
        },
        "files": [
            "src/helpers.php"
        ],
        "classmap": [
            "database/factories"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyar.ranjbar0@gmail.com"
        }
    ],
    "minimum-stability": "alpha",
    "extra": {
        "laravel": {
            "providers": [
                "Elyar\\TelegramBotEssentials\\TelegramBotServiceProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "orchestra/testbench": "^10.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
