{
    "name": "telegram-bot-essentials/essence",
    "description": "A Laravel framework for building multi-bot Telegram applications: command, reply-key and callback-query buses, conversational state, and per-bot tenancy.",
    "type": "library",
    "keywords": [
        "laravel",
        "telegram",
        "telegram-bot",
        "bot-framework",
        "multi-tenancy"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Elyar",
            "email": "elyar.ranjbar0@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "laravel/framework": "^12 || ^13",
        "ramsey/uuid": "^4.7",
        "stancl/tenancy": "^3.9"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/telescope": "^5.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.1 || ^4.0"
    },
    "suggest": {
        "laravel/telescope": "Tags handled exceptions with BUG so they can be filtered in the Telescope UI."
    },
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\Essence\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ],
        "classmap": [
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TelegramBotEssentials\\Essence\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\Essence\\TelegramBotServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-chore/phase-0-hygiene": "0.12.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
