{
    "name": "telegram-bot-essentials/essence",
    "description": "This is the how i like to develop my bots and handle different incoming requests",
    "type": "library",
    "require": {
        "php": "^8.2",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "laravel/framework": "^12 || ^13",
        "ramsey/uuid": "^4.7",
        "stancl/tenancy": "^3.9",
        "laravel/telescope": "*",
        "elyar/personal-laravel-helpers": "*"
    },
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\Essence\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ],
        "classmap": [
            "database/factories"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyar.ranjbar0@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\Essence\\TelegramBotServiceProvider"
            ]
        }
    }
}
